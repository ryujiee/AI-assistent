# Copie para .env (lido pelo docker compose). Nunca versione o .env.

# IA
OPENAI_API_KEY=

# Painel: senha do administrador (12+ caracteres) e segredo das sessões
ADMIN_PASSWORD=
SESSION_SECRET=            # openssl rand -hex 32

# Banco (o Postgres só escuta em 127.0.0.1)
POSTGRES_USER=secretary_user
POSTGRES_PASSWORD=troque-esta-senha   # só vale na criação do volume; para trocar depois: ALTER USER ...
POSTGRES_DB=secretary_db

# Gestor financeiro (tabelas criadas por: secretary migrate apply)
FINANCE_ENABLED=false

# pgAdmin opcional: docker compose --profile tools up -d pgadmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=
